---
import BaseLayout from '@/layouts/BaseLayout.astro';
import TOC from '@/components/TOC.astro';
import TagPill from '@/components/TagPill.astro';
import { entrySlug, formatDate, readingMinutes, categoryLabel } from '@/lib/utils';
import { basePath } from '@/lib/base';
import { render } from 'astro:content';
import { getBlogPosts } from '@/lib/collections';

export async function getStaticPaths() {
  const posts = await getBlogPosts();
  return posts.map((p) => ({ params: { slug: entrySlug(p) }, props: { p } }));
}

const { p } = Astro.props;
const { Content, headings } = await render(p);
---

<BaseLayout title={p.data.title} description={p.data.description}>
  <div class="article-grid">
    <article class="min-w-0">
      <a class="article-back" href={`${basePath}/blog`}>← All writeups</a>
      <header class="article-header">
        <div class="article-date">
          <span>{readingMinutes(p.body)} min read · </span>
          {formatDate(p.data.date)}{
            p.data.updated ? ` · updated ${formatDate(p.data.updated)}` : ''
          }
          {p.data.ctf_event ? ` · ${p.data.ctf_event}` : ''}
        </div>
        <h1 class="section-title article-title">{p.data.title}</h1>
        {p.data.description && <p class="article-description">{p.data.description}</p>}

        <div class="mt-4 flex flex-wrap gap-2">
          {(p.data.tags ?? []).map((t) => <TagPill tag={t} />)}
        </div>

        <div class="mt-4 flex flex-wrap gap-2 text-xs text-white/58">
          {p.data.category && <span class="chip">{categoryLabel(p.data.category)}</span>}
          {p.data.difficulty && <span class="chip">{p.data.difficulty}</span>}
        </div>
      </header>

      <TOC headings={headings} mobile />

      <div class="article-body prose prose-invert max-w-none">
        <Content />
      </div>

      <div
        class="mt-10 flex items-center justify-between rounded-3xl border border-white/12 bg-white/5 p-5"
      >
        <a class="text-sm text-white/74 hover:text-white" href={`${basePath}/blog`}
          >← Back to list</a
        >
        <a class="text-sm text-white/74 hover:text-white" href={`${basePath}/`}>Home →</a>
      </div>
    </article>

    <TOC headings={headings} />
  </div>
</BaseLayout>
