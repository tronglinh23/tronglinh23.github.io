---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import PostCard from '@/components/PostCard.astro';
import { basePath } from '@/lib/base';
import { getBlogPosts } from '@/lib/collections';
import { blogPath } from '@/lib/utils';

const blog = (await getBlogPosts()).slice(0, 4);
---

<BaseLayout title="Home">
  <Hero />

  <section class="mt-10" data-reveal>
    <div class="mb-4 flex flex-wrap items-end justify-between gap-3">
      <div>
        <div class="section-kicker">Latest Logs</div>
        <h2 class="section-title mt-2 text-2xl">Latest writeups</h2>
        <p class="section-desc mt-1 text-sm">From recent investigations and challenges.</p>
      </div>
      <a
        class="rounded-xl border border-white/14 bg-white/6 px-3 py-2 text-sm text-white/78 hover:border-white/24 hover:bg-white/12 hover:text-white"
        href={`${basePath}/blog`}
      >
        View all →
      </a>
    </div>

    <div class="recent-grid">
      {blog.map((p) => <PostCard entry={p} href={blogPath(p, basePath)} />)}
    </div>
  </section>

  <section class="mt-10 grid gap-4 md:grid-cols-3" data-reveal>
    <a
      href={`${basePath}/links`}
      class="surface-panel interactive-card rounded-3xl p-5"
      data-reveal
      data-reveal-delay="1"
    >
      <div class="text-xs uppercase tracking-[0.1em] text-white/56">Research</div>
      <h3 class="mt-2 text-lg font-semibold text-white/92">Curated Link Vault</h3>
      <p class="mt-2 text-sm text-white/70">Saved references, docs, and challenge resources.</p>
    </a>

    <a
      href={`${basePath}/tags`}
      class="surface-panel interactive-card rounded-3xl p-5"
      data-reveal
      data-reveal-delay="2"
    >
      <div class="text-xs uppercase tracking-[0.1em] text-white/56">Map</div>
      <h3 class="mt-2 text-lg font-semibold text-white/92">Tag Navigation</h3>
      <p class="mt-2 text-sm text-white/70">Jump quickly by topic: web, cloud, pwn, rev, crypto.</p>
    </a>

    <a
      href={`${basePath}/about`}
      class="surface-panel interactive-card rounded-3xl p-5"
      data-reveal
      data-reveal-delay="3"
    >
      <div class="text-xs uppercase tracking-[0.1em] text-white/56">Profile</div>
      <h3 class="mt-2 text-lg font-semibold text-white/92">CTF Timeline</h3>
      <p class="mt-2 text-sm text-white/70">Contest achievements, focus areas, and background.</p>
    </a>
  </section>
</BaseLayout>
