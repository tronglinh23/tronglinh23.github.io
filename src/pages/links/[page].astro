---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { basePath } from '@/lib/base';
import LinkCard from '@/components/LinkCard.astro';
import PageIntro from '@/components/PageIntro.astro';
import { getLinkPosts } from '@/lib/collections';

export async function getStaticPaths({ paginate }) {
  const pageSize = 10;
  const links = await getLinkPosts();

  return paginate(links, { pageSize });
}

const { page } = Astro.props;
const pageLinks = page.data;
const totalPages = page.lastPage;
const currentPage = page.currentPage;
const pageHref = (n) => (n === 1 ? `${basePath}/links` : `${basePath}/links/${n}`);
---

<BaseLayout
  title={`Research · Page ${currentPage}`}
  description="Curated articles, papers, and references from around the web."
>
  <PageIntro
    kicker="Knowledge Radar"
    title="Research"
    description="Curated articles, docs, and references worth revisiting."
  />

  <div class="grid gap-4">
    {pageLinks.map((p) => <LinkCard entry={p} />)}
  </div>

  {
    totalPages > 1 && (
      <nav
        class="mt-8 flex flex-wrap items-center justify-between gap-3 text-sm text-white/72"
        data-reveal
      >
        <span>
          Page {currentPage} of {totalPages}
        </span>
        <div class="flex flex-wrap gap-2">
          {currentPage > 1 && (
            <a
              class="rounded-2xl border border-white/14 bg-black/24 px-3 py-2 text-white/80 transition hover:border-white/24 hover:bg-white/12 hover:text-white"
              href={pageHref(currentPage - 1)}
            >
              ← Prev
            </a>
          )}
          {currentPage < totalPages && (
            <a
              class="rounded-2xl border border-white/14 bg-black/24 px-3 py-2 text-white/80 transition hover:border-white/24 hover:bg-white/12 hover:text-white"
              href={pageHref(currentPage + 1)}
            >
              Next →
            </a>
          )}
        </div>
      </nav>
    )
  }
</BaseLayout>
