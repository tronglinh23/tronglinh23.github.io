---
import { site } from '@/config/site';
import AnimatedButton from '@/components/ui/AnimatedButton.astro';
import { basePath } from '@/lib/base';

const normalize = (value) => {
  const withoutSlash = value.replace(/\/+$/, '');
  return withoutSlash === '' ? '/' : withoutSlash;
};

const currentPath = normalize(Astro.url.pathname);
const base = basePath === '/' ? '' : basePath;

const isActive = (href) => {
  const target = normalize(`${base}${href}`);
  if (target === '/') return currentPath === '/';
  return currentPath === target || currentPath.startsWith(`${target}/`);
};
---

<header class="sticky top-0 z-30 border-b border-white/10 bg-black/30 backdrop-blur-2xl">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-3.5">
    <a class="group flex items-center gap-3" href={`${basePath}/`} transition:name="site-brand">
      <span
        class="grid h-10 w-10 place-items-center rounded-2xl border border-white/15 bg-black/35 shadow-[0_0_22px_rgba(116,195,255,0.28)]"
      >
        <img
          class="h-6 w-6 animate-floaty"
          src={`${basePath}/astronaut.svg`}
          alt="astronaut"
          data-animated="true"
        />
      </span>
      <div class="leading-tight">
        <div class="text-sm font-semibold text-white/92 group-hover:text-white">{site.title}</div>
        <div class="text-[11px] text-white/60">{site.author.tagline}</div>
      </div>
    </a>

    <nav class="hidden items-center gap-2 lg:flex">
      {
        site.nav.map((item) => {
          const active = isActive(item.href);
          return (
            <a
              class={`rounded-xl px-3 py-2 text-sm transition ${
                active
                  ? 'border border-white/20 bg-white/10 text-white shadow-[0_0_18px_rgba(122,205,255,0.2)]'
                  : 'text-white/74 hover:bg-white/8 hover:text-white'
              }`}
              href={`${basePath}${item.href}`}
              aria-current={active ? 'page' : undefined}
            >
              {item.label}
            </a>
          );
        })
      }

      <button
        type="button"
        data-effects-toggle
        aria-pressed="false"
        class="rounded-xl border border-white/14 bg-white/5 px-3 py-2 text-xs text-white/80 hover:bg-white/10"
      >
        Effects: Full
      </button>

      <AnimatedButton href={`${basePath}/blog`} label="Explore" />
    </nav>

    <details class="relative lg:hidden">
      <summary
        class="list-none rounded-xl border border-white/14 bg-white/6 px-3 py-2 text-sm text-white/82 hover:bg-white/10"
      >
        Menu
      </summary>
      <div class="surface-panel absolute right-0 mt-3 w-56 rounded-2xl p-2">
        {
          site.nav.map((item) => {
            const active = isActive(item.href);
            return (
              <a
                class={`block rounded-xl px-3 py-2 text-sm transition ${
                  active
                    ? 'border border-white/20 bg-white/10 text-white'
                    : 'text-white/74 hover:bg-white/10 hover:text-white'
                }`}
                href={`${basePath}${item.href}`}
                aria-current={active ? 'page' : undefined}
              >
                {item.label}
              </a>
            );
          })
        }
        <button
          type="button"
          data-effects-toggle
          aria-pressed="false"
          class="mt-1 block w-full rounded-xl border border-white/14 bg-white/6 px-3 py-2 text-left text-xs text-white/80 hover:bg-white/10"
        >
          Effects: Full
        </button>
        <div class="mt-2 border-t border-white/10 pt-2">
          <a
            class="block rounded-xl border border-white/12 bg-black/20 px-3 py-2 text-sm text-white/82 hover:bg-white/10"
            href={`${basePath}/blog`}
          >
            Explore →
          </a>
        </div>
      </div>
    </details>
  </div>
</header>
