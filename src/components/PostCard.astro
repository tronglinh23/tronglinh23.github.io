---
import { formatDate, readingMinutes, categoryLabel } from '@/lib/utils';

const { entry, href } = Astro.props;
const data = entry.data;
const tags = (data.tags ?? []).map((t: string) => t.trim()).filter(Boolean);
---

<a href={href} class="post-card" data-category={data.category} data-reveal>
  <div class="post-card-meta">
    <span class="category-label">{categoryLabel(data.category)}</span>
    {data.ctf_event && <span>{data.ctf_event}</span>}
    <span class="post-card-date"
      ><time datetime={data.date.toISOString()}>{formatDate(data.date)}</time></span
    >
  </div>
  <div class="post-card-heading">
    <h3>{data.title}</h3><span class="post-card-arrow" aria-hidden="true">↗</span>
  </div>
  {data.description && <p class="post-card-description">{data.description}</p>}
  <div class="post-card-footer">
    <div class="post-card-tags">{tags.slice(0, 4).map((tag: string) => <span>#{tag}</span>)}</div>
    <div class="post-card-details">
      {
        data.difficulty && (
          <span class="difficulty" data-level={data.difficulty}>
            {data.difficulty}
          </span>
        )
      }
      <span>{readingMinutes(entry.body)} min read</span>
    </div>
  </div>
  {data.updated && <div class="post-card-updated">Updated {formatDate(data.updated)}</div>}
</a>
