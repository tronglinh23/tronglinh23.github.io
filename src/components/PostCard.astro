---
import TagPill from '@/components/TagPill.astro';
import { formatDate } from '@/lib/utils';

const { entry, href } = Astro.props;
const data = entry.data;

const tags = (data.tags ?? [])
  .map((t) => (typeof t === 'string' ? t.trim() : ''))
  .filter((t) => t.length > 0);
---

<a
  href={href}
  class="surface-panel interactive-card card-spotlight group block rounded-3xl p-5"
  data-reveal
>
  <div class="flex items-start justify-between gap-4">
    <div>
      <div class="text-xs tracking-wide text-white/52">
        {formatDate(data.date)}{data.updated ? ` · updated ${formatDate(data.updated)}` : ''}
      </div>
      <h3 class="mt-2 text-xl font-semibold text-white/92 group-hover:text-white">{data.title}</h3>
      <p class="mt-2 line-clamp-2 text-sm text-white/72">{data.description}</p>
    </div>
    <div
      class="hidden h-10 w-10 items-center justify-center rounded-2xl border border-white/14 bg-black/26 text-white/70 transition group-hover:translate-x-0.5 group-hover:border-white/26 group-hover:text-white md:flex"
    >
      ↗
    </div>
  </div>

  {
    tags.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-2">
        {tags.slice(0, 5).map((t) => (
          <TagPill tag={t} link={false} />
        ))}
      </div>
    )
  }

  <div class="mt-4 flex flex-wrap gap-2 text-xs text-white/58">
    {data.ctf_event && <span class="chip">{data.ctf_event}</span>}
    {data.category && <span class="chip">{data.category}</span>}
    {data.difficulty && <span class="chip">{data.difficulty}</span>}
  </div>
</a>
