---
import { entrySlug, formatDate, categoryLabel } from '@/lib/utils';
import { basePath } from '@/lib/base';

const { entry } = Astro.props;
const data = entry.data;
const resources = 1 + (data.extra_links?.length ?? 0);
const domain = new URL(data.source_url).hostname.replace(/^www\./, '');
---

<a
  href={`${basePath}/links/${entrySlug(entry)}`}
  class="post-card"
  data-category="research"
  data-reveal
>
  <div class="post-card-meta">
    <span class="category-label">{categoryLabel(data.category)}</span>
    <span class="post-card-date"
      ><time datetime={data.date.toISOString()}>{formatDate(data.date)}</time></span
    >
  </div>
  <div class="post-card-heading">
    <h3>{data.title}</h3><span class="post-card-arrow" aria-hidden="true">↗</span>
  </div>
  <p class="post-card-description">{data.description}</p>
  <div class="post-card-footer">
    <div class="post-card-tags">
      {(data.tags ?? []).slice(0, 8).map((tag) => <span>#{tag}</span>)}
    </div>
    <span class="post-card-details"
      >{domain} · {resources} {resources === 1 ? 'resource' : 'resources'}</span
    >
  </div>
</a>
