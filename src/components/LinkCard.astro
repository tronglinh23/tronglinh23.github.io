---
import TagPill from '@/components/TagPill.astro';
import { entrySlug, formatDate } from '@/lib/utils';
import { basePath } from '@/lib/base';

const { entry } = Astro.props;
const data = entry.data;
const slug = entrySlug(entry);
---

<a
  href={`${basePath}/links/${slug}`}
  class="surface-panel interactive-card card-spotlight block rounded-3xl p-5"
  data-reveal
>
  <div class="text-xs tracking-wide text-white/52">{formatDate(data.date)} · {data.category}</div>
  <h3 class="mt-2 text-xl font-semibold text-white/92">{data.title}</h3>
  <p class="mt-2 text-sm text-white/72">{data.description}</p>

  {
    (data.tags ?? []).length > 0 && (
      <div class="mt-4 flex flex-wrap gap-2">
        {(data.tags ?? []).slice(0, 8).map((t) => (
          <TagPill tag={t} link={false} />
        ))}
      </div>
    )
  }

  <div class="mt-4 inline-flex items-center gap-2 text-sm font-medium text-sky-100/88">
    Open links <span class="text-white/56">→</span>
  </div>
</a>
