---
/**
 * Props:
 * - items: array of { title, description, date, href, tags, category, difficulty, ctf_event }
 * - initialCategory?: string
 */
const { items, initialCategory } = Astro.props;

const unique = (arr) => [...new Set(arr.filter(Boolean))].sort((a, b) => a.localeCompare(b));
const categories = unique(items.map((i) => i.category));
const difficulties = unique(items.map((i) => i.difficulty));
const events = unique(items.map((i) => i.ctf_event));
const tags = unique(items.flatMap((i) => i.tags || []));

const payload = JSON.stringify({ items, categories, difficulties, events, tags, initialCategory });
---

<div class="surface-panel rounded-3xl p-5" data-search-payload={payload}>
  <div class="grid gap-3 md:grid-cols-2 xl:grid-cols-5">
    <input
      id="q"
      class="w-full rounded-2xl border border-white/14 bg-black/22 px-4 py-3 text-sm text-white/88 placeholder:text-white/42 focus:border-white/28 focus:outline-none"
      placeholder="Search title, tags, description..."
      autocomplete="off"
    />
    <select
      id="cat"
      class="w-full rounded-2xl border border-white/14 bg-black/22 px-4 py-3 text-sm text-white/88 focus:border-white/28 focus:outline-none"
    >
      <option value="">All categories</option>
      {categories.map((c) => <option value={c}>{c}</option>)}
    </select>
    <select
      id="diff"
      class="w-full rounded-2xl border border-white/14 bg-black/22 px-4 py-3 text-sm text-white/88 focus:border-white/28 focus:outline-none"
    >
      <option value="">All difficulty</option>
      {difficulties.map((d) => <option value={d}>{d}</option>)}
    </select>
    <select
      id="evt"
      class="w-full rounded-2xl border border-white/14 bg-black/22 px-4 py-3 text-sm text-white/88 focus:border-white/28 focus:outline-none"
    >
      <option value="">All events</option>
      {events.map((e) => <option value={e}>{e}</option>)}
    </select>
    <select
      id="sort"
      class="w-full rounded-2xl border border-white/14 bg-black/22 px-4 py-3 text-sm text-white/88 focus:border-white/28 focus:outline-none"
    >
      <option value="newest">Sort: Newest</option>
      <option value="oldest">Sort: Oldest</option>
      <option value="title">Sort: Title A-Z</option>
    </select>
  </div>

  <div class="mt-4 flex flex-wrap items-center gap-2">
    <div class="text-xs text-white/56">Quick tags:</div>
    <div id="tagCloud" class="flex flex-wrap gap-2"></div>
  </div>

  <div class="mt-4 flex items-center justify-between gap-2 text-xs text-white/56">
    <div><span id="count"></span></div>
    <button
      id="reset"
      class="rounded-xl border border-white/14 bg-white/6 px-3 py-2 text-white/76 hover:bg-white/12 hover:text-white"
      type="button"
    >
      Reset
    </button>
  </div>
</div>

<script is:inline>
  const root = document.currentScript?.previousElementSibling;
  const raw = root?.getAttribute('data-search-payload') || '{}';
  const DATA = JSON.parse(raw);

  function initSearch() {
    const elQ = document.getElementById('q');
    const elCat = document.getElementById('cat');
    const elDiff = document.getElementById('diff');
    const elEvt = document.getElementById('evt');
    const elSort = document.getElementById('sort');
    const elCount = document.getElementById('count');
    const elTagCloud = document.getElementById('tagCloud');
    const elReset = document.getElementById('reset');
    const list = document.getElementById('results');

    if (
      !elQ ||
      !elCat ||
      !elDiff ||
      !elEvt ||
      !elSort ||
      !elCount ||
      !elTagCloud ||
      !elReset ||
      !list
    )
      return;

    const defaultMarkup = list.innerHTML;

    function renderTags() {
      elTagCloud.innerHTML = '';
      const top = (DATA.tags || [])
        .filter((t) => typeof t === 'string' && t.trim().length > 0)
        .slice(0, 20);

      top.forEach((t) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className =
          'rounded-full border border-white/14 bg-white/6 px-3 py-1 text-xs text-white/76 hover:bg-white/12 hover:text-white';
        b.textContent = '#' + t;
        b.addEventListener('click', () => {
          elQ.value = t;
          apply();
        });
        elTagCloud.appendChild(b);
      });
    }

    function matches(item, q, cat, diff, evt) {
      if (cat && item.category !== cat) return false;
      if (diff && item.difficulty !== diff) return false;
      if (evt && item.ctf_event !== evt) return false;

      if (!q) return true;
      const hay = [
        item.title,
        item.description,
        item.category,
        item.difficulty,
        item.ctf_event,
        ...(item.tags || []),
      ]
        .filter(Boolean)
        .join(' ')
        .toLowerCase();

      return hay.includes(q.toLowerCase());
    }

    function sortItems(items, mode) {
      const list = [...items];
      if (mode === 'oldest') {
        return list.sort((a, b) => new Date(a.date).getTime() - new Date(b.date).getTime());
      }
      if (mode === 'title') {
        return list.sort((a, b) => a.title.localeCompare(b.title));
      }
      return list.sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
    }

    function createEl(tag, className, text) {
      const el = document.createElement(tag);
      if (className) el.className = className;
      if (text !== undefined) el.textContent = text;
      return el;
    }

    function renderResults(items) {
      list.innerHTML = '';
      if (!items.length) {
        list.appendChild(
          createEl(
            'div',
            'rounded-3xl border border-white/14 bg-white/5 p-6 text-sm text-white/66',
            'No matches found. Try a different query or clear filters.'
          )
        );
        return;
      }

      const frag = document.createDocumentFragment();
      items.forEach((it) => {
        const card = createEl(
          'a',
          'surface-panel interactive-card card-spotlight group block rounded-3xl p-5'
        );
        card.href = it.href;

        const header = createEl('div', 'flex items-start justify-between gap-4');
        const left = createEl('div');
        left.appendChild(
          createEl('div', 'text-xs tracking-wide text-white/52', it.dateLabel || '')
        );
        left.appendChild(
          createEl(
            'h3',
            'mt-2 text-xl font-semibold text-white/92 group-hover:text-white',
            it.title
          )
        );
        left.appendChild(createEl('p', 'mt-2 line-clamp-2 text-sm text-white/72', it.description));

        const right = createEl(
          'div',
          'hidden h-10 w-10 items-center justify-center rounded-2xl border border-white/14 bg-black/26 text-white/70 transition group-hover:translate-x-0.5 group-hover:border-white/26 group-hover:text-white md:flex',
          '↗'
        );
        header.appendChild(left);
        header.appendChild(right);
        card.appendChild(header);

        const tagsWrap = createEl('div', 'mt-4 flex flex-wrap gap-2');
        (it.tags || [])
          .filter((t) => typeof t === 'string' && t.trim().length > 0)
          .slice(0, 5)
          .forEach((t) => {
            tagsWrap.appendChild(
              createEl(
                'span',
                'inline-flex items-center rounded-full border border-white/14 bg-white/6 px-3 py-1 text-xs text-white/78',
                `#${t}`
              )
            );
          });
        card.appendChild(tagsWrap);

        const meta = createEl('div', 'mt-4 flex flex-wrap gap-2 text-xs text-white/58');
        if (it.ctf_event)
          meta.appendChild(
            createEl(
              'span',
              'inline-flex rounded-full border border-white/14 bg-white/6 px-3 py-1',
              it.ctf_event
            )
          );
        if (it.category)
          meta.appendChild(
            createEl(
              'span',
              'inline-flex rounded-full border border-white/14 bg-white/6 px-3 py-1',
              it.category
            )
          );
        if (it.difficulty)
          meta.appendChild(
            createEl(
              'span',
              'inline-flex rounded-full border border-white/14 bg-white/6 px-3 py-1',
              it.difficulty
            )
          );
        card.appendChild(meta);

        frag.appendChild(card);
      });
      list.appendChild(frag);
    }

    function apply() {
      const q = elQ.value.trim();
      const cat = elCat.value;
      const diff = elDiff.value;
      const evt = elEvt.value;
      const sort = elSort.value;

      const filtered = (DATA.items || []).filter((it) => matches(it, q, cat, diff, evt));
      const sorted = sortItems(filtered, sort);

      elCount.textContent = sorted.length + ' results';

      const isDefault = !q && !cat && !diff && !evt && sort === 'newest';
      if (isDefault) {
        list.innerHTML = defaultMarkup;
        document.dispatchEvent(new CustomEvent('ui:results-updated'));
        return;
      }

      renderResults(sorted);
      document.dispatchEvent(new CustomEvent('ui:results-updated'));
    }

    let applyTimer;
    function scheduleApply() {
      clearTimeout(applyTimer);
      applyTimer = setTimeout(apply, 120);
    }

    elQ.addEventListener('input', scheduleApply);
    elCat.addEventListener('change', apply);
    elDiff.addEventListener('change', apply);
    elEvt.addEventListener('change', apply);
    elSort.addEventListener('change', apply);

    elReset.addEventListener('click', () => {
      elQ.value = '';
      elCat.value = '';
      elDiff.value = '';
      elEvt.value = '';
      elSort.value = 'newest';
      apply();
    });

    renderTags();
    if (DATA.initialCategory) elCat.value = DATA.initialCategory;
    apply();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSearch);
  } else {
    initSearch();
  }
</script>
