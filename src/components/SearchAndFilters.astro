---
import PostCard from '@/components/PostCard.astro';
import { categoryLabel } from '@/lib/utils';

const { items, posts, currentPage = 1, pageSize = 10 } = Astro.props;
const unique = (values: string[]) =>
  [...new Set(values.filter(Boolean))].sort((a, b) => a.localeCompare(b));
const categories = unique(items.map((i) => i.category));
const difficulties = unique(items.map((i) => i.difficulty));
const events = unique(items.map((i) => i.ctf_event));
const tags = unique(items.flatMap((i) => i.tags));
const tagCounts = new Map<string, number>();
for (const item of items)
  for (const tag of item.tags) tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
const popularTags = [...tagCounts]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .slice(0, 8);
const first = items.length ? (currentPage - 1) * pageSize + 1 : 0;
const last = Math.min(currentPage * pageSize, items.length);
const defaultCount = `Showing ${first}–${last} of ${items.length} writeups`;
---

<section
  class="archive-search"
  data-search-payload={JSON.stringify(items)}
  data-default-count={defaultCount}
  aria-label="Find a writeup"
>
  <div class="search-input-wrap">
    <label for="q" class="sr-only">Search writeup titles, descriptions, and tags</label>
    <svg
      aria-hidden="true"
      viewBox="0 0 24 24"
      width="20"
      height="20"
      fill="none"
      stroke="currentColor"
      stroke-width="1.7"
      ><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="m16 16 4.5 4.5"></path></svg
    >
    <input
      id="q"
      type="search"
      placeholder="Find a writeup, technique, or challenge…"
      autocomplete="off"
    />
    <kbd aria-hidden="true">/</kbd>
  </div>
  <div class="search-filter-grid">
    <label
      >Category<select id="cat"
        ><option value="">All categories</option>{
          categories.map((c) => <option value={c}>{categoryLabel(c)}</option>)
        }</select
      ></label
    >
    <label
      >Difficulty<select id="diff"
        ><option value="">Any difficulty</option>{
          difficulties.map((d) => <option value={d}>{d[0].toUpperCase() + d.slice(1)}</option>)
        }</select
      ></label
    >
    <label
      >Event<select id="evt"
        ><option value="">All events</option>{
          events.map((e) => <option value={e}>{e}</option>)
        }</select
      ></label
    >
    <label
      >Tag<select id="tag"
        ><option value="">All tags</option>{tags.map((t) => <option value={t}>{t}</option>)}</select
      ></label
    >
  </div>
  <div class="quick-tags">
    <span>Popular</span>{
      popularTags.map(([tag]) => (
        <button type="button" data-quick-tag={tag} aria-pressed="false">
          #{tag}
        </button>
      ))
    }
  </div>
  <div class="search-status-row">
    <p id="count" role="status" aria-live="polite" aria-atomic="true">{defaultCount}</p>
    <div class="search-status-actions">
      <button id="reset" type="button" hidden>Clear filters</button>
      <label class="sr-only" for="sort">Sort writeups</label>
      <select id="sort"
        ><option value="newest">Newest first</option><option value="oldest">Oldest first</option
        ><option value="title">Title A–Z</option></select
      >
    </div>
  </div>
  <noscript
    ><p class="mt-3 text-sm text-white/70">
      Search needs JavaScript. You can still browse every writeup using the page navigation below.
    </p></noscript
  >
  {
    items.map((item, index) => (
      <template data-search-card={item.slug}>
        <PostCard entry={posts[index]} href={item.href} />
      </template>
    ))
  }
</section>

<script>
  import {
    isSearchActive,
    readSearchState,
    selectSearchItems,
    type SearchItem,
    type SearchState,
  } from '@/lib/search';

  const root = document.querySelector<HTMLElement>('[data-search-payload]');
  const list = document.getElementById('results');
  if (root && list) {
    const items: SearchItem[] = JSON.parse(root.dataset.searchPayload || '[]');
    const query = root.querySelector<HTMLInputElement>('#q')!;
    const category = root.querySelector<HTMLSelectElement>('#cat')!;
    const difficulty = root.querySelector<HTMLSelectElement>('#diff')!;
    const event = root.querySelector<HTMLSelectElement>('#evt')!;
    const tag = root.querySelector<HTMLSelectElement>('#tag')!;
    const sort = root.querySelector<HTMLSelectElement>('#sort')!;
    const count = root.querySelector<HTMLElement>('#count')!;
    const reset = root.querySelector<HTMLButtonElement>('#reset')!;
    const pagination = document.querySelector<HTMLElement>('[data-archive-pagination]');
    const original = list.innerHTML;
    const templates = new Map(
      Array.from(root.querySelectorAll<HTMLTemplateElement>('template[data-search-card]')).map(
        (template) => [template.dataset.searchCard, template]
      )
    );
    const quickTags = root.querySelectorAll<HTMLButtonElement>('[data-quick-tag]');
    const controls = { q: query, category, difficulty, event, tag, sort };

    function state(): SearchState {
      return {
        q: query.value.trim(),
        category: category.value,
        difficulty: difficulty.value,
        event: event.value,
        tag: tag.value,
        sort: sort.value as SearchState['sort'],
      };
    }

    function apply(updateUrl = true) {
      const filters = state();
      const active = isSearchActive(filters);
      if (pagination) pagination.hidden = active;
      reset.hidden = !active;
      quickTags.forEach((button) =>
        button.setAttribute('aria-pressed', String(button.dataset.quickTag === filters.tag))
      );
      if (!active) {
        list!.innerHTML = original;
        count.textContent = root!.dataset.defaultCount || '';
      } else {
        const results = selectSearchItems(items, filters);
        count.textContent = `${results.length} ${results.length === 1 ? 'writeup' : 'writeups'} found`;
        list!.replaceChildren();
        const fragment = document.createDocumentFragment();
        for (const item of results) {
          const template = templates.get(item.slug);
          if (template) fragment.appendChild(template.content.cloneNode(true));
        }
        if (!results.length) {
          const empty = document.createElement('div');
          empty.className = 'search-empty';
          const heading = document.createElement('h2');
          heading.textContent = 'No writeups found';
          const hint = document.createElement('p');
          hint.textContent = 'Try a broader search or clear your filters to explore the archive.';
          const clear = document.createElement('button');
          clear.type = 'button';
          clear.className = 'quiet-action';
          clear.textContent = 'Clear all filters →';
          clear.addEventListener('click', clearFilters);
          empty.append(heading, hint, clear);
          fragment.appendChild(empty);
        }
        list!.appendChild(fragment);
      }
      if (updateUrl) {
        const url = new URL(window.location.href);
        for (const [key, value] of Object.entries(filters)) {
          if (value && !(key === 'sort' && value === 'newest')) url.searchParams.set(key, value);
          else url.searchParams.delete(key);
        }
        window.history.replaceState(null, '', url);
      }
      document.dispatchEvent(new CustomEvent('ui:results-updated'));
    }

    let timer: ReturnType<typeof setTimeout>;
    function clearFilters() {
      clearTimeout(timer);
      for (const control of Object.values(controls)) control.value = '';
      sort.value = 'newest';
      apply();
      query.focus();
    }
    function restore() {
      clearTimeout(timer);
      const filters = readSearchState(new URLSearchParams(window.location.search));
      for (const [key, control] of Object.entries(controls))
        control.value = filters[key as keyof SearchState];
      if (!sort.value) sort.value = 'newest';
      apply(false);
    }
    query.addEventListener('input', () => {
      clearTimeout(timer);
      timer = setTimeout(() => apply(), 120);
    });
    for (const select of [category, difficulty, event, tag, sort])
      select.addEventListener('change', () => {
        clearTimeout(timer);
        apply();
      });
    reset.addEventListener('click', clearFilters);
    quickTags.forEach((button) =>
      button.addEventListener('click', () => {
        tag.value = tag.value === button.dataset.quickTag ? '' : button.dataset.quickTag || '';
        clearTimeout(timer);
        apply();
      })
    );
    document.addEventListener('keydown', (e) => {
      const target = e.target;
      if (
        e.key !== '/' ||
        e.metaKey ||
        e.ctrlKey ||
        e.altKey ||
        !(target instanceof HTMLElement) ||
        target.closest('input, textarea, select, [contenteditable]')
      )
        return;
      e.preventDefault();
      query.focus();
    });
    window.addEventListener('popstate', restore);
    restore();
  }
</script>
