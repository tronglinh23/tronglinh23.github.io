---
import { basePath } from '@/lib/base';
import { getBlogPosts, getLinkPosts } from '@/lib/collections';
import { site } from '@/config/site';

const posts = await getBlogPosts();
const links = await getLinkPosts();
const topics = [
  { label: 'Web exploitation', query: 'category=web' },
  { label: 'Cloud security', query: 'tag=cloud-security' },
  { label: 'Forensics', query: 'category=for' },
  { label: 'Binary exploitation', query: 'category=pwn' },
];
---

<section class="logbook-hero" aria-labelledby="hero-title">
  <div>
    <div class="section-kicker">{site.author.name}'s field notes</div>
    <h1 id="hero-title">CTF writeups &amp;<br /><span>security research.</span></h1>
    <p class="hero-description">
      The challenges, the rabbit holes, and what I learned along the way. Notes on web exploitation,
      cloud security, and forensics.
    </p>
    <div class="hero-actions">
      <a class="primary-action" href={`${basePath}/blog`}
        >Explore the writeups <span aria-hidden="true">↗</span></a
      >
      <a class="quiet-action" href={`${basePath}/links`}
        >Research collection <span aria-hidden="true">→</span></a
      >
    </div>
    <div class="hero-stats">
      <a href={`${basePath}/blog`}><strong>{posts.length}</strong> writeups</a>
      <span aria-hidden="true">/</span>
      <a href={`${basePath}/links`}><strong>{links.length}</strong> saved resources</a>
    </div>
  </div>
  <aside class="hero-directory" aria-label="Browse by focus area">
    <div class="directory-heading">
      <img src={`${basePath}/astronaut.svg`} alt="" width="36" height="36" /><span
        >Pick a rabbit hole</span>
    </div>
    {
      topics.map((topic, i) => (
        <a href={`${basePath}/blog?${topic.query}`}>
          <>
            <span class="directory-number">0{i + 1}</span>
            <span>{topic.label}</span>
            <span aria-hidden="true">↗</span>
          </>
        </a>
      ))
    }
    <a
      class="notion-link"
      href="https://xon1l.notion.site/0f7cc27a1426404e9383b15583584137?v=b53480fa8c5241b6b2577c0cb42da2e5"
      target="_blank"
      rel="noopener noreferrer">Older labs on Notion <span aria-hidden="true">↗</span></a
    >
  </aside>
</section>
