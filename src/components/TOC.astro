---
const { headings = [] } = Astro.props;

function indentClass(depth) {
  if (depth >= 3) return 'pl-6';
  if (depth >= 2) return 'pl-3';
  return 'pl-0';
}
---

{
  headings.length > 0 && (
    <aside
      class="surface-panel sticky top-24 hidden max-h-[72vh] w-64 overflow-auto rounded-3xl p-4 lg:block"
      data-reveal
    >
      <div class="mb-3 text-xs font-semibold tracking-[0.12em] text-white/64">ON THIS PAGE</div>
      <nav class="space-y-1 text-sm">
        {headings
          .filter((h) => h.depth <= 3)
          .map((h) => (
            <a
              class={`block rounded-xl px-2 py-1.5 text-white/68 transition hover:bg-white/7 hover:text-white ${indentClass(
                h.depth
              )}`}
              href={`#${h.slug}`}
            >
              {h.text}
            </a>
          ))}
      </nav>
    </aside>
  )
}
