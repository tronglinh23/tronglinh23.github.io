---
const { headings = [], mobile = false } = Astro.props;
const sections = headings.filter((heading) => heading.depth <= 3);
---

{
  sections.length > 0 &&
    (mobile ? (
      <details class="mobile-toc">
        <summary>
          On this page <span>{sections.length} sections</span>
        </summary>
        <nav aria-label="Article contents">
          {sections.map((heading) => (
            <a
              class:list={['toc-link', { 'toc-nested': heading.depth >= 3 }]}
              href={`#${heading.slug}`}
            >
              {heading.text}
            </a>
          ))}
        </nav>
      </details>
    ) : (
      <aside class="desktop-toc">
        <div class="toc-title">On this page</div>
        <nav aria-label="Article contents">
          {sections.map((heading) => (
            <a
              class:list={['toc-link', { 'toc-nested': heading.depth >= 3 }]}
              href={`#${heading.slug}`}
            >
              {heading.text}
            </a>
          ))}
        </nav>
        <a class="toc-back" href="#main-content">
          Back to top ↑
        </a>
      </aside>
    ))
}

<script>
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc-link'));
  const headings = Array.from(
    new Set(
      links
        .map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
        .filter((heading): heading is HTMLElement => Boolean(heading))
    )
  );
  if (headings.length && 'IntersectionObserver' in window) {
    const update = () => {
      let active = headings[0];
      for (const heading of headings) {
        if (heading.getBoundingClientRect().top <= 180) active = heading;
        else break;
      }
      links.forEach((link) => {
        const current = decodeURIComponent(link.hash.slice(1)) === active.id;
        if (current) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
    };
    const observer = new IntersectionObserver(update, {
      rootMargin: '-100px 0px -60% 0px',
      threshold: 0,
    });
    headings.forEach((heading) => observer.observe(heading));
    update();
  }
  document.querySelectorAll<HTMLAnchorElement>('.mobile-toc .toc-link').forEach((link) =>
    link.addEventListener('click', () => {
      const disclosure = link.closest('details');
      if (disclosure) disclosure.open = false;
    })
  );
</script>
